# ====================================================================
# BUILDREX — Environment Configuration Template
# ====================================================================

# Port & Secret
PORT=3000
JWT_SECRET=buildrex-super-secure-enterprise-jwt-key-2026

# GEMINI_API_KEY: Required for Gemini AI API calls (Auto-polish, Radar, Feedback).
GEMINI_API_KEY=""

# ====================================================================
# TiDB Cloud Database Configuration (Distributed Cloud MySQL)
# ====================================================================
# 1. Create a free Serverless cluster at https://tidbcloud.com (Free forever, 25 GiB)
# 2. In your TiDB Cloud Cluster overview, click "Connect" -> "General"
# 3. Copy the Host, Port (default 4000), User, and Password below:
#
# If TIDB_HOST is left empty or offline, BUILDREX smoothly operates
# using its built-in local JSON file store fallback.
# ====================================================================
TIDB_HOST="gateway01.us-east-1.prod.aws.tidbcloud.com"
TIDB_PORT=4000
TIDB_USER="your_cluster_prefix.root"
TIDB_PASSWORD="your_tidb_password"
TIDB_DATABASE="buildrex"
TIDB_SSL=true
